#!/usr/bin/env bash
# set -x
set -e

ls -1 ./package-examples | while read PACKAGE; do
	PDIR="./package-examples/$PACKAGE"
	if [[ ! -d "$PDIR" ]]; then 
		continue
	fi
	
	echo "
---------------------------------
  "$PDIR"
---------------------------------
"
	pushd "$PDIR"
	npm install
	npm run test
	popd
done
